<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<Pane prefHeight="524.0" prefWidth="600.0" style="-fx-background-color: gray;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.projeto.poo.controller.user.ListaUsuarioController">

   <children>

      <ScrollPane layoutX="128.0" layoutY="-1.0" prefHeight="523.0" prefWidth="473.0">

         <content>
            <VBox fx:id="vboxUsuarios" spacing="10">
               <padding>
                  <Insets bottom="10" left="10" right="10" top="10" />
               </padding>
            </VBox>
         </content>

      </ScrollPane>

      <Button layoutX="14.0" layoutY="14.0" onAction="#irParaHome" prefHeight="38.0" prefWidth="100.0" text="Voltar" />

      <Button layoutX="14.0" layoutY="68.0" onAction="#irParaEditarUsuario" prefHeight="38.0" prefWidth="100.0" text="Editar" />

      <Button layoutX="14.0" layoutY="125.0" prefHeight="38.0" prefWidth="100.0" text="Salvar" />
      <TextField fx:id="formBuscaUsuario" layoutX="14.0" layoutY="236.0" prefHeight="25.0" prefWidth="107.0" promptText="Buscar Usuario" />
      <Button fx:id="btnBusca" layoutX="27.0" layoutY="275.0" mnemonicParsing="false" onAction="#carregarBusca" prefHeight="25.0" prefWidth="74.0" text="Buscar" />

      
   </children>
</Pane>
