<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.Pane?>



<Pane prefHeight="480.0" prefWidth="519.0"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.projeto.poo.controller.RegistroController">

   <children>

      <TextField fx:id="txtuser"
                 layoutX="98.0"
                 layoutY="240.0"
                 prefHeight="35.0"
                 prefWidth="305.0"
                 promptText="Digite Seu Nome:" />

      <PasswordField fx:id="txtsenha"
                     layoutX="98.0"
                     layoutY="317.0"
                     prefHeight="35.0"
                     prefWidth="305.0"
                     promptText="Digite Sua Senha" />

      <Button layoutX="221.0"
              layoutY="370.0"
              text="Registrar"
              onAction="#gerarRegistro"/>

      <Label fx:id="lblSucesso"
             layoutX="221.0"
             layoutY="418.0"/>

   </children>
</Pane>
